SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/littlenet?sslmode=require
BASE_URL=https://your-littlenet-web.example
COOKIE_SECURE=1
ENABLE_DEV_OTP=0

# Production transactional email. SMTP variables below are legacy/dev-only.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=no-reply@littlenet.in
RESEND_FROM_NAME=LittleNet
RESEND_DOMAIN_VERIFIED=1
MAIL_EMAIL=
MAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
AI_SERVICE_URL=https://your-littlenet-ai.example
AI_SHARED_SECRET=replace-with-another-long-random-secret
AI_REQUEST_TIMEOUT=180
# Cost guard: readiness stays passive unless a deep probe is explicitly enabled.
AI_DEEP_HEALTH=0
# Cost guard: recommendation ranking is deterministic/CPU-only by default.
# Keep both flags disabled in the college demo so opening Feed/Reels never wakes Modal T4
# and never loads the local CLIP model into the web process.
AI_ENABLE_REMOTE_RANKING=0
LITTLENET_ENABLE_LOCAL_RECOMMENDATION_MODEL=0

# Upload moderation cost guards. Production Modal web enables the CPU image tier.
# Leave GPU fallback off unless you deliberately accept T4 spend during a CPU-tier outage.
LITTLENET_USE_MODAL_IMAGE_CPU=0
LITTLENET_ALLOW_IMAGE_GPU_FALLBACK=0
LITTLENET_USE_MODAL_TEXT_CPU=0
LITTLENET_ALLOW_TEXT_GPU_FALLBACK=0
LITTLENET_IMAGE_MODERATION_MAX_PX=1600
LITTLENET_MODERATION_CACHE_VERSION=2026-09-20-v1
LITTLENET_MODERATION_CACHE_TTL_DAYS=30

UPLOAD_FOLDER=/tmp/littlenet-uploads
MODEL_CACHE_DIR=/tmp/littlenet-models

# Cloudflare R2 private media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=littlenet-media
R2_SIGNED_URL_TTL=300

# Optional adaptive Reel delivery. Leave disabled until a Cloudflare Stream
# account/token/subdomain are configured in the backend secret.
CLOUDFLARE_STREAM_ENABLED=0
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SUBDOMAIN=
CLOUDFLARE_STREAM_API_TIMEOUT_SECONDS=20
# Recommended at higher playback-token volume. Values come from a Stream signing key.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY_B64=

# Async media processing. Production uses the Modal-native Function.spawn queue.
JOB_QUEUE_PROVIDER=local
LITTLENET_SYNC_JOBS=0

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI hardening
# Production image moderation screens burned-in text/PII through OCR.
LITTLENET_ENABLE_OCR=1
LITTLENET_MODEL_TIMEOUT_SECONDS=90
LITTLENET_VIDEO_FRAMES_TIMEOUT_SECONDS=240
LITTLENET_VIDEO_SAMPLE_INTERVAL_SECONDS=4
LITTLENET_VIDEO_MAX_FRAMES=24
LITTLENET_ENABLE_SCENEDETECT=1
LITTLENET_SCENEDETECT_THRESHOLD=27
LITTLENET_SCENEDETECT_MIN_FRAMES=12
LITTLENET_DETOXIFY_MODEL=multilingual
LITTLENET_DANGEROUS_OBJECTS=
LITTLENET_ENABLE_OPENNSFW2=0
LITTLENET_ENABLE_EXTRA_NSFW=0
LITTLENET_EXTRA_NSFW_MODEL=
LITTLENET_ENABLE_TEXT_CLASSIFIER=0
LITTLENET_TEXT_SAFETY_MODEL=
# May tighten the reviewed Facenet512 distance threshold; values above 0.35
# are capped so deployment configuration cannot weaken identity matching.
LITTLENET_FACE_MATCH_MAX_DISTANCE=0.35

APP_TIMEZONE=Asia/Kolkata

K2_HORIZON_ENABLED=true
K2_HORIZON_BASE_URL=https://api.ifm.ai/v1
K2_HORIZON_API_KEY=
K2_HORIZON_MODEL=IFM/K2-Horizon-375B-A23B
K2_CONNECT_TIMEOUT=5
K2_READ_TIMEOUT=30
K2_MAX_RETRIES=2
K2_CIRCUIT_BREAKER_THRESHOLD=5
K2_CIRCUIT_BREAKER_RESET_SECONDS=60
