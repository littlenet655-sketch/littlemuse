#!/usr/bin/env bash
# Capture logcat from a device into a timestamped file for the test report.
# Usage: ./collect-logcat [serial] [duration-seconds]  (0 = until Ctrl-C)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

SERIAL="${1:-emulator-5554}"
DURATION="${2:-0}"
OUT="$SCRIPT_DIR/logcat-${SERIAL}-$(date +%Y%m%d-%H%M%S).txt"

require_bins
echo "Capturing logcat from $SERIAL -> $OUT"
if [ "$DURATION" -gt 0 ]; then
  timeout "$DURATION" "$ADB" -s "$SERIAL" logcat -v threadtime > "$OUT" || true
else
  "$ADB" -s "$SERIAL" logcat -v threadtime > "$OUT"
fi
echo "Saved: $OUT"
